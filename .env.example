# Vision Craft AI provider router
# Supported: openai | gemini | local
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Gemini
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Local/self-hosted OpenAI-compatible AI server
# Example: Ollama/vLLM/another OpenAI-compatible endpoint
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_API_KEY=
LOCAL_ANALYSIS_MODEL=qwen2.5:7b-instruct
LOCAL_TRANSCRIPTION_MODEL=whisper-1

# Existing media worker configuration is environment-specific and should not
# be committed with real credentials.
